          "start": 68,
          "end": 75,
          "body": [
            "  in(field: string, value: relationalStore.ValueType[], condition: boolean = true): Wrapper {\n",
            "    if (condition) {\n",
            "      const str = new Array(value.length).fill('?').join(',')\n",
            "      this.whereList.push(`and ${field} in (${str})`)\n",
            "      this.valueList.push(...value)\n",
            "    }\n",
