        "69-85:insert": {
          "start": 69,
          "end": 85,
          "body": [
            "  insert(obj: T) {\n",
            "    // 取出数据库字段\n",
            "    let values: relationalStore.ValueType[] = []\n",
            "    for (let propertyKey of this.propertyKeys){\n",
            "      let v = obj[propertyKey]\n",
            "      if (v !== undefined) {\n",
            "        values.push(v)\n",
            "      } else {\n",
            "        values.push(null)\n",
            "      }\n",
            "    }\n",
            "    let sql = `INSERT INTO ${this.tableName} (${this.fieldsTemp}) VALUES (${this.valueTemp});`\n",
            "    return {\n",
            "      sql: sql,\n",
            "      values: values\n",
            "    } as SqlData\n",
            "  }\n"
          ],
