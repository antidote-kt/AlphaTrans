            "  static getInstance() {\n",
            "    if (!EmpMapper.mapper) {\n",
            "      EmpMapper.mapper = BaseMapper.build<Employee>({\n",
            "        class: Employee,\n",
            "        config: {\n",
            "          name: 'RdbTest.db', // 数据库文件名\n",
            "          securityLevel: relationalStore.SecurityLevel.S3, // 数据库安全级别\n",
            "        }\n",
            "      })\n",
            "    }\n",
            "    return EmpMapper.mapper\n",
            "  }\n"
